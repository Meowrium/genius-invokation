+  //AI 控制方法 - 允许外部 MCP 控制 AI 玩家
+  enableAiMode(roomId: number, playerId: number | string): boolean {
+    const room = this.rooms.get(roomId);
+    if (!room) {
+      throw new NotFoundException(`Room ${roomId} not found`);
+    }
+    const player = room.players.find(p => p.id === playerId);
+    if (!player) {
+      throw new NotFoundException(`Player ${playerId} not found in room`);
+    }
+    (player as any).enableAiMode();
+    this.logger.log(`AI mode enabled for player ${playerId} in room ${roomId}`);
+    return true;
+  }
+
+  disableAiMode(roomId: number, playerId: number | string): boolean {
+    const room = this.rooms.get(roomId);
+    if (!room) {
+      throw new NotFoundException(`Room ${roomId} not found`);
+    }
+    const player = room.players.find(p => p.id === playerId);
+    if (!player) {
+      throw new NotFoundException(`Player ${playerId} not found in room`);
+    }
+    (player as any).disableAiMode();
+    this.logger.log(`AI mode disabled for player ${playerId} in room ${roomId}`);
+    return true;
+  }
+
+  isAiMode(roomId: number, playerId: number | string): boolean {
+    const room = this.rooms.get(roomId);
+    if (!room) {
+      throw new NotFoundException(`Room ${roomId} not found`);
+    }
+    const player = room.players.find(p => p.id === playerId);
+    if (!player) {
+      throw new NotFoundException(`Player ${playerId} not found in room`);
+    }
+    return (player as any).isAiMode();
+  }
+
+  getAiRequest(roomId: number, playerId: number | string): RpcRequest | null {
+    const room = this.rooms.get(roomId);
+    if (!room) {
+      throw new NotFoundException(`Room ${roomId} not found`);
+    }
+    const player = room.players.find(p => p.id === playerId);
+    if (!player) {
+      throw new NotFoundException(`Player ${playerId} not found in room`);
+    }
+    return (player as any).getAiCurrentRequest();
+  }
+
+  respondToAi(roomId: number, playerId: number | string, rawResponse: any): boolean {
+    const room = this.rooms.get(roomId);
+    if (!room) {
+      throw new NotFoundException(`Room ${roomId} not found`);
+    }
+    const player = room.players.find(p => p.id === playerId);
+    if (!player) {
+      throw new NotFoundException(`Player ${playerId} not found in room`);
+    }
+    
+    // 转换为 RpcResponse
+    const response: RpcResponse = {
+      success: rawResponse.success,
+      values: rawResponse.values || {},
+      cardSelection: rawResponse.cardSelection,
+      dieSelection: rawResponse.dieSelection,
+    };
+    
+    (player as any).aiRespond(response);
+    this.logger.log(`AI response sent to player ${playerId} in room ${roomId}`);
+    return true;
+  }
