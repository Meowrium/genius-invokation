  "annotationGuide": {
    "steps": [
      "1. Program extracts hard facts: card/character set, counts, costs, elements, explicit preconditions and effects",
      "2. Two annotators independently fill analysisV2 gold; they only see the same input, not any candidate model answers or heuristic conclusions",
      "3. Third annotator resolves disagreements, preserving acceptableAlternatives",
      "4. Compute Krippendorff's alpha for profile, key pieces, and matchup plan; fields below 0.67 get rubric revisions or multi-answer",
      "5. Write annotator-explained input IDs into gold for audit"
    ],
    "constraints": [
      "Test set must include decks/variants frozen only after initial development",
      "Must not use any model's analysis output to generate or adjudicate gold",
      "Weights and confidence must be in [0, 1]",
      "primaryArchetypes are labels with weight >= 0.35",
      "Each key conclusion must have at least one evidence",
      "Use abstentions when no reliable basis exists"
    ]
  }
