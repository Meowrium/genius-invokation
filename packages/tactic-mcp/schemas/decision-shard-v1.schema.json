{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtcg.local/schemas/decision-shard-v1.schema.json",
  "title": "Tactic Decision Shard V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "shard_id",
    "session_id",
    "plan_id",
    "turn_range",
    "tactical_goal",
    "candidate_policies",
    "execution_constraints",
    "fallback_chain",
    "exit_conditions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "DecisionShardV1"
    },
    "shard_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tactical_goal": {
      "type": "string",
      "minLength": 1
    },
    "candidate_policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "preconditions", "action_template"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action_template": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "args"],
            "properties": {
              "tool": {
                "type": "string",
                "enum": [
                  "submit_decision_fragment_v1",
                  "choose_action",
                  "elemental_tuning",
                  "choose_active",
                  "reroll_dice",
                  "switch_hands",
                  "select_card"
                ]
              },
              "args": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "execution_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_actions_this_turn", "dice_budget_mode"],
      "properties": {
        "max_actions_this_turn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "dice_budget_mode": {
          "type": "string",
          "enum": ["strict", "balanced", "aggressive"]
        },
        "protect_character_definition_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "forbid_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fallback_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "policy"],
        "properties": {
          "when": {
            "type": "string"
          },
          "policy": {
            "type": "string",
            "enum": ["skip_low_value", "save_dice", "hp_stabilize", "force_switch"]
          }
        }
      }
    },
    "exit_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "combat_window_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_id",
        "plan_horizon",
        "entry_conditions",
        "interrupt_conditions",
        "success_conditions",
        "fail_conditions",
        "entry_node_id",
        "nodes"
      ],
      "properties": {
        "window_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_horizon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_actions", "max_actions"],
          "properties": {
            "min_actions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "max_actions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        },
        "entry_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interrupt_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "success_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fail_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entry_node_id": {
          "type": "string",
          "minLength": 1
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "intent",
              "when",
              "must_do",
              "avoid",
              "prefer_tags",
              "next"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["setup", "pivot", "convert", "burst", "survive", "exit"]
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "expected_action_case": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["useSkill", "playCard", "switchActive", "declareEnd", "selectCard"]
                }
              },
              "when": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_do": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prefer_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "resource_policy": {
                "type": "string",
                "enum": ["strict", "balanced", "aggressive"]
              },
              "fallback_rule": {
                "type": "string"
              },
              "next": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["condition", "to", "priority"],
                  "properties": {
                    "condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "priority": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "telemetry_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
